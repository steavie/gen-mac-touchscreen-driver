<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Touchscreen-Treiber</string>

    <key>CFBundleDisplayName</key>
    <string>Touchscreen-Treiber</string>

    <!-- Bewusst identisch zum Signatur-Identifier der früheren
         Kommandozeilen-Version: das Designated Requirement bleibt dadurch
         gleich (Identifier + Zertifikat), sodass erteilte TCC-Freigaben
         möglichst weitergelten. -->
    <key>CFBundleIdentifier</key>
    <string>de.aronax.touchscreen-driver</string>

    <key>CFBundleExecutable</key>
    <string>TouchscreenDriver</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>2.2</string>

    <key>CFBundleVersion</key>
    <string>2.2</string>

    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>de</string>
    </array>

    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Nur Menüleiste: kein Dock-Symbol, kein Eintrag im Programmwechsler -->
    <key>LSUIElement</key>
    <true/>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <key>NSHumanReadableCopyright</key>
    <string>Privates Werkzeug, keine Gewährleistung.</string>
</dict>
</plist>
