"Driver stopped" = "Driver stopped";
"Connected: %@" = "Connected: %@";
"No touch device found" = "No touch device found";
"Touch device" = "Touch device";
"Touchscreen driver" = "Touchscreen driver";
"Touchscreen driver is running" = "Touchscreen driver is running";
