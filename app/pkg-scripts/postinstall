#!/bin/bash
# Läuft als root nach dem Kopieren der App.
#
# Aufgaben:
#  1. Die alte Kommandozeilen-Version abräumen (LaunchAgent). Liefe die
#     weiter, gäbe es zwei Treiber gleichzeitig und jeder Klick käme doppelt.
#  2. Die App im Kontext des angemeldeten Benutzers starten.
set -u

APP="/Applications/Touchscreen-Treiber.app"
LABEL="de.aronax.touchscreen-driver"

# Der Installer läuft als root - wir brauchen aber den angemeldeten Benutzer,
# dessen LaunchAgent-Domain und GUI-Sitzung.
CONSOLE_USER=$(stat -f %Su /dev/console)
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
    echo "Kein angemeldeter Benutzer gefunden, überspringe Start."
    exit 0
fi
USER_UID=$(id -u "$CONSOLE_USER")
USER_HOME=$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | awk '{print $2}')

# 1. Alte Kommandozeilen-Version abräumen
launchctl bootout "gui/$USER_UID/$LABEL" 2>/dev/null || true
rm -f "$USER_HOME/Library/LaunchAgents/$LABEL.plist"

# Eine eventuell noch laufende alte Kommandozeilen-Instanz beenden
pkill -u "$USER_UID" -f "touchscreen-driver/touchscreen-driver" 2>/dev/null || true

# 2. Eine bereits laufende Instanz der App beenden. Wichtig bei einem
#    Update: die App wurde gerade unter den Füßen ausgetauscht, und ohne das
#    liefen nach dem Start unten ZWEI Treiber - jeder Klick käme doppelt.
pkill -u "$USER_UID" -f "Touchscreen-Treiber.app/Contents/MacOS" 2>/dev/null || true
sleep 1

# 3. App als Benutzer starten
launchctl asuser "$USER_UID" sudo -u "$CONSOLE_USER" open -a "$APP" 2>/dev/null || true

exit 0
