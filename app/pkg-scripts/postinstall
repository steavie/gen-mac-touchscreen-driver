#!/bin/bash
# Runs as root after the app has been copied into place.
#
# Tasks:
#  1. Remove the old command line version (LaunchAgent). If it kept running
#     there would be two drivers and every click would land twice.
#  2. Start the app in the context of the logged-in user.
set -u

APP="/Applications/Touchscreen-Treiber.app"
LABEL="de.aronax.touchscreen-driver"

# The installer runs as root, but we need the logged-in user, their
# LaunchAgent domain and their GUI session.
CONSOLE_USER=$(stat -f %Su /dev/console)
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
    echo "No logged-in user found, skipping launch."
    exit 0
fi
USER_UID=$(id -u "$CONSOLE_USER")
USER_HOME=$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | awk '{print $2}')

# 1. remove the old command line version
launchctl bootout "gui/$USER_UID/$LABEL" 2>/dev/null || true
rm -f "$USER_HOME/Library/LaunchAgents/$LABEL.plist"

# terminate a possibly still running old command line instance
pkill -u "$USER_UID" -f "touchscreen-driver/touchscreen-driver" 2>/dev/null || true

# 2. Terminate an already running instance of the app. Important on update:
#    the app was just swapped out underneath it, and without this the launch
#    below would leave TWO drivers running — every click would land twice.
pkill -u "$USER_UID" -f "Touchscreen-Treiber.app/Contents/MacOS" 2>/dev/null || true
sleep 1

# 3. start the app as the user
launchctl asuser "$USER_UID" sudo -u "$CONSOLE_USER" open -a "$APP" 2>/dev/null || true

exit 0
