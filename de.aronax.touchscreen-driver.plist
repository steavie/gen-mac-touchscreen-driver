<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.aronax.touchscreen-driver</string>

    <key>ProgramArguments</key>
    <array>
        <string>$HOME/touchscreen-driver/touchscreen-driver</string>
        <!-- Ziel-Display fest über seine EDID-Kennung. Ohne das greift die
             Automatik "nicht der Hauptbildschirm" daneben, sobald der
             Touchscreen selbst zum Hauptbildschirm gemacht wird.
             Passende Werte liefert: touchscreen-driver --list -->
        <string>--display</string>
        <string>4837:8448:20000080</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/touchscreen-driver/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/touchscreen-driver/stderr.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
